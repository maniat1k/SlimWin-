<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SlimWin.Desktop.App"
             xmlns:local="using:SlimWin.Desktop"
             xmlns:conv="using:SlimWin.Core.Converters"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:ResultToBrushConverter x:Key="ResultToBrushConverter" />
        <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
    </Application.Resources>
</Application>
